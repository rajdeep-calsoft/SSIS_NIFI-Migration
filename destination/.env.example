# ---- Ports (change if something already uses them) ----
NIFI_PORT=8080
POSTGRES_PORT=5433
GRAFANA_PORT=3000

# ---- Postgres ----
POSTGRES_DB=etldemo
POSTGRES_USER=etl
POSTGRES_PASSWORD=etlpass

# The SOURCE (SSIS) stack's own Postgres password -- needed by
# db/init/04_ssis_fdw.sql to read that warehouse via postgres_fdw for the
# comparison dashboard. Must match ../source/.env's POSTGRES_PASSWORD.
SSIS_POSTGRES_PASSWORD=etlpass

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---- NiFi JVM (keep small: demo box has ~4.6GB free) ----
NIFI_HEAP_INIT=512m
NIFI_HEAP_MAX=1g

# ---- Generator ----
# seconds between batches
BATCH_INTERVAL=10
# orders per batch
BATCH_SIZE=50
# fraction of records deliberately broken (0.0 - 1.0)
ERROR_RATE=0.05
# fixed seed => reproducible demo data; blank => random each run
GEN_SEED=42

# ---- In-flow real-time rules ----
# These match the SSIS engine's thresholds exactly (its
# stream_runner.py HIGH_VALUE_MIN / SUSPICIOUS_QTY). Changing one here
# without changing it there makes the two engines disagree on alerts.
# a single LINE total above this raises a HIGH_VALUE alert
HIGH_VALUE_THRESHOLD=500
# single line qty above this raises a SUSPICIOUS_QTY alert
SUSPICIOUS_QTY=50

# ---- Monitor ----
MONITOR_INTERVAL=5

# ---- Parallel run with the SSIS engine ----
# One generator feeds BOTH engines from this host folder. It must match
# SHARED_DATA in ../source/docker-compose.yml (both default to the same
# path, so this only needs setting explicitly if you move the repo again).
SHARED_DATA=/home/rajdeep/Desktop/Final/source/data
# File-level faults (malformed / empty files) are the one place the two
# engines disagree by design - off while comparing, 1 to demo them solo.
FILE_FAULTS=0
