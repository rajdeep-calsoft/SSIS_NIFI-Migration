POSTGRES_DB=telecom
POSTGRES_USER=telecom_etl
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5437
NIFI_PORT=8085
NIFI_HEAP_INIT=1g
NIFI_HEAP_MAX=2g

# Consumed by migrator/ (see jobs/telecom_cdr/job.yml's destination_db.password_ref)
# and report/ -- the value that fills in the DBCPConnectionPool's Password at
# deploy time. Must equal POSTGRES_PASSWORD above.
TELECOM_DB_PASSWORD=changeme

# Grafana (destination/docker-compose.yml's grafana service): its own
# admin login, plus how it reaches source's Postgres (the OTHER stack) --
# these must match source/.env's POSTGRES_PORT/DB/USER, and
# SRC_PG_PASSWORD (wired from POSTGRES_PASSWORD above) must equal source/.env's
# POSTGRES_PASSWORD -- same one-secret-duplicated-on-purpose convention as
# TELECOM_DB_PASSWORD.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3002
SOURCE_POSTGRES_PORT=5436
SOURCE_POSTGRES_DB=telecom
SOURCE_POSTGRES_USER=telecom_etl
