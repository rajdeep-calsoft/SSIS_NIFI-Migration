        "type": "grafana-postgresql-datasource",
        "uid": "etl-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 9,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT agreement_pct AS v FROM v_agreement",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "etl-postgres"
