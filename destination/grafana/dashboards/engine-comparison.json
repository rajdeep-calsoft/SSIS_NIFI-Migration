    {
      "type": "table",
      "title": "What each engine produced",
      "description": "The four totals that have to match. Order lines matter most: if the engines load different rows, nothing below is comparable.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "etl-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT m.label AS \"Measure\", m.nifi AS \"NiFi\", m.ssis AS \"SSIS\",       m.nifi - m.ssis AS \"Delta\"  FROM v_compare_totals t,  LATERAL (VALUES (1,'Orders',      t.nifi_orders,  t.ssis_orders),                  (2,'Order lines', t.nifi_lines,   t.ssis_lines),                  (3,'Rejected',    t.nifi_rejects, t.ssis_rejects),                  (4,'Alerts',      t.nifi_alerts,  t.ssis_alerts))       AS m(ord,label,nifi,ssis) ORDER BY m.ord",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "etl-postgres"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
