    {
      "type": "table",
      "title": "Every rejected record, both engines",
      "description": "One row per rejected record, with BOTH engines' verdicts on it. Disagreements sort to the top, so if the first row is green there are none. '\u2014 loaded \u2014' means that engine accepted the record. Green is both engines reaching the same conclusion, amber is one rejecting what the other kept, red is both rejecting for different reasons. `make compare` prints the same set and exits non-zero on it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "etl-postgres"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('second', at) AS at, order_id, line_no, nifi_says AS \"NiFi says\", ssis_says AS \"SSIS says\", agree, CASE WHEN why LIKE '%did not match the schema%'      THEN 'wrong type: ' || replace(replace(           regexp_replace(why, '^.*schema: ', ''), '[',''), ']','')      ELSE left(coalesce(why, ''), 70) END AS detail FROM v_reject_side_by_side ORDER BY (agree = 'same'), at DESC, order_id LIMIT 60",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "etl-postgres"
          },
          "editorMode": "code"
        }
      ],
