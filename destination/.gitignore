# Runtime data (regenerated by the stack)
data/landing/*
data/archive/*
data/dlq/*
data/exports/*
data/rejects/*
!data/**/.gitkeep

# Vendored JDBC driver (fetched by `make setup`)
nifi/drivers/*.jar

# Local env
.env

# Python
__pycache__/
*.pyc
.venv/

# Scratch
*.log

# Legacy docs: kept locally, never committed
docs/

# The bulk fixture is 29 MB. Fixture generation is deterministic, so it is
# regenerated rather than committed:  make fixture TIER=tier3-bulk
spec/fixtures/tier3-bulk.ndjson

# Captured evidence from `make capture`, not source.
spec/compare/runs/*.json

# Skills installed with `npx skills add` (vercel-labs/skills CLI).
# skills-lock.json IS committed -- it pins the source and hash of each one, so
# `npx skills update` restores exactly these. The skill bodies themselves are
# third-party vendored text and do not belong in this repo's history.
.agents/
