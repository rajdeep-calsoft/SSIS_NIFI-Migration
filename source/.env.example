POSTGRES_DB=telecom
POSTGRES_USER=telecom_etl
# Must equal destination/.env's POSTGRES_PASSWORD / TELECOM_DB_PASSWORD --
# one secret, genuinely duplicated on purpose across two independent Docker
# stacks (same convention the reference repo documents for its api/.env vs
# destination/.env). report/ connects to both Postgres instances directly
# and needs the same value either way.
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5436
GEN_SEED=42
ERROR_RATE=0.08
# Host path NiFi's landing dir actually lives at (destination/data/landing) --
# override if you've moved destination/ elsewhere relative to source/.
SHARED_LANDING_DIR=../destination/data/landing
