{
  "uid": "ssis-stream-live",
  "title": "2 - Business Live (SSIS)",
  "description": "What the pipeline is actually delivering: live orders, lines, revenue, and the in-stream alert rules firing.",
  "tags": [
    "live",
    "business"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Orders",
      "description": "Distinct orders in the warehouse.\n\nIn a shell: `docker logs -f ssis-engine`, or\n  docker exec -it ssis-warehouse psql -U etl_user -d etl_db",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT order_id) AS v FROM dw.fact_sales",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d95926",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Lines",
      "description": "Order lines loaded. Always >= orders; the ratio is the average basket size.\n\nIn a shell: `docker logs -f ssis-engine`, or\n  docker exec -it ssis-warehouse psql -U etl_user -d etl_db",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS v FROM dw.fact_sales",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#199e70",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Revenue",
      "description": "Sum of every loaded line total. Money belongs to neither engine, so it is never painted in an engine's colour.\n\nIn a shell: `docker logs -f ssis-engine`, or\n  docker exec -it ssis-warehouse psql -U etl_user -d etl_db",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(coalesce(sum(total_price),0)) AS v FROM dw.fact_sales",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#199e70",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Alerts raised",
      "description": "In-stream rule hits: HIGH_VALUE and SUSPICIOUS_QTY. An alert is not a reject -- the record still loaded.\n\nIn a shell: `docker logs -f ssis-engine`, or\n  docker exec -it ssis-warehouse psql -U etl_user -d etl_db",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS v FROM control.stream_alerts",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Orders and lines per minute",
      "description": "Both series count the same stream at two grains. A flat line here is a stalled pipeline, whatever the tiles above say -- they are running totals and never go down.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', load_timestamp) AS time, count(DISTINCT order_id) AS \"orders\", count(*) AS \"lines\" FROM dw.fact_sales WHERE $__timeFilter(load_timestamp) GROUP BY 1 ORDER BY 1",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "spanNulls": true,
            "gradientMode": "opacity",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "orders"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lines"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Revenue per minute",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', load_timestamp) AS time, sum(total_price) AS \"revenue\" FROM dw.fact_sales WHERE $__timeFilter(load_timestamp) GROUP BY 1 ORDER BY 1",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "spanNulls": true,
            "gradientMode": "opacity",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "revenue"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "table",
      "title": "Live alerts - the in-stream rules firing",
      "description": "Written by the engine's own rules as the data streams past. The rejection log lives on the Pipeline Health board, not here: a rejected record never arrives, an alerted one did.\n\nIn a shell: `docker logs -f ssis-engine`, or\n  docker exec -it ssis-warehouse psql -U etl_user -d etl_db",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('second', alert_ts) AS at, alert_type, order_id, customer_id, round(alert_value) AS value, detail::text AS detail FROM control.stream_alerts ORDER BY alert_ts DESC, alert_id DESC LIMIT 25",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false,
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyINR"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "at"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 185
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alert_type"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "order_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 245
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "customer_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      }
    }
  ]
}