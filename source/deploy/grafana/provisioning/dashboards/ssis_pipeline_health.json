{
  "uid": "ssis-pipeline-health",
  "title": "1 - Pipeline Health (SSIS)",
  "description": "The SSIS engine's own board, laid out exactly like the NiFi one so the two can be read side by side. Source: ssis_sim/stream_runner.py.",
  "tags": [
    "ssis",
    "health",
    "migration"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Orders loaded",
      "description": "Distinct orders in the warehouse fact table.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT order_id) AS v FROM dw.fact_sales",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d95926",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Records rejected",
      "description": "Rows in the DLQ, across all reject reasons. A count, not a rate -- it only ever grows.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS v FROM control.dlq_errors",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Reject rate",
      "description": "Rejected lines as a share of every line read. THIS is the health number, not the count beside it. Same thresholds as the NiFi board so the two colours mean the same thing.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN coalesce(sum(lines_in), 0) = 0 THEN 0 ELSE round(100.0 * sum(lines_rejected) / sum(lines_in), 2) END AS v FROM control.stream_file",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 25
              },
              {
                "color": "#d03b3b",
                "value": 90
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Failed files",
      "description": "Files this engine could not process cleanly.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS v FROM control.stream_file WHERE status <> 'PASS'",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Ingest throughput",
      "description": "Lines landing in the warehouse per minute.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', load_timestamp) AS time, count(*) AS \"lines loaded\" FROM dw.fact_sales WHERE $__timeFilter(load_timestamp) GROUP BY 1 ORDER BY 1",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "spanNulls": true,
            "gradientMode": "opacity",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lines loaded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Why records were rejected",
      "description": "The reject vocabulary, as this engine reports it. These reason names are shared verbatim with the NiFi engine - a spelling difference would read as a behavioural one.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT error_type AS reason, count(*) AS records FROM control.dlq_errors GROUP BY 1 ORDER BY 2 DESC",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#fab219"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisSoftMin": 0,
            "axisGridShow": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "barWidth": 0.58,
        "barRadius": 0.25,
        "showValue": "always",
        "text": {
          "valueSize": 12
        },
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        },
        "xTickLabelRotation": 0
      }
    },
    {
      "type": "table",
      "title": "File ledger - one row per input file",
      "description": "This engine's job ledger. Every file that arrived leaves a row. The NiFi board draws the same eight columns from its job_runs table, so the two line up row against row.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT processed_at, source_file, status, lines_in, lines_clean, lines_rejected, orders_loaded, revenue FROM control.stream_file ORDER BY processed_at DESC LIMIT 25",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false,
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RUNNING": {
                        "color": "#3987e5",
                        "index": 0,
                        "text": "RUNNING"
                      },
                      "SUCCESS": {
                        "color": "#0ca30c",
                        "index": 1,
                        "text": "SUCCESS"
                      },
                      "PASS": {
                        "color": "#0ca30c",
                        "index": 2,
                        "text": "PASS"
                      },
                      "PARTIAL": {
                        "color": "#fab219",
                        "index": 3,
                        "text": "PARTIAL"
                      },
                      "FAILED": {
                        "color": "#d03b3b",
                        "index": 4,
                        "text": "FAILED"
                      },
                      "FAIL": {
                        "color": "#d03b3b",
                        "index": 5,
                        "text": "FAIL"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "processed_at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "revenue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyINR"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "processed_at"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 185
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "source_file"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 330
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      }
    },
    {
      "type": "table",
      "title": "Rejection log - every record this engine refused",
      "description": "The record, the reason, and the offending value -- newest first. Same nine columns as the NiFi board, so the two tables can be read row against row.\n\nAll of it, in a shell:\n  make errors           both engines, with a reason diff\n  docker exec -it ssis-warehouse psql -U etl_user -d etl_db\n      SELECT * FROM control.dlq_errors ORDER BY dlq_id DESC;\n\nFor the engine's own errors: `docker logs -f ssis-engine`, or the control.etl_run_log table.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_uid"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('second', detected_at AT TIME ZONE 'UTC') AS at, order_id, raw_payload->>'line_no'    AS line_no, raw_payload->>'sku'        AS sku, raw_payload->>'qty'        AS qty, raw_payload->>'unit_price' AS unit_price, raw_payload->>'currency'   AS currency, error_type AS reason, error_detail AS detail FROM control.dlq_errors ORDER BY detected_at DESC, dlq_id DESC LIMIT 25",
          "datasource": {
            "type": "postgres",
            "uid": "postgres_uid"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false,
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reason"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fab219"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "at"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 185
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "order_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 245
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "line_no"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sku"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "qty"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unit_price"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "currency"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "reason"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 175
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      }
    }
  ]
}